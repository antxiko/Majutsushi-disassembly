# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x4010 interrupcion el gancho H.KEYI: sonido (bancos 12-13-14) y el cuadro del juego
L 0x405C suma_a_hl HL = HL + A
L 0x4061 suma_a_de DE = DE + A
L 0x4066 despacha salta a la palabra A de la tabla que va detras del call
L 0x4070 init el arranque del cartucho (INIT)
L 0x40C1 cartucho_en_8000 pone el cartucho tambien en 0x8000-0xBFFF (ENASLT)
L 0x40E1 ranura_del_cartucho la ranura del cartucho, en 0xF0F4
L 0x40FD pide_sonido_01 pide el sonido 0x01 al motor de sonido (p12:6003)
L 0x4102 pide_sonido_02 pide el sonido 0x02
L 0x4107 pide_sonido_03 pide el sonido 0x03
L 0x410C pide_sonido_04 pide el sonido 0x04
L 0x4111 pide_sonido_05 pide el sonido 0x05
L 0x4116 pide_sonido_06 pide el sonido 0x06 (el del cursor)
L 0x411B pide_sonido_07 pide el sonido 0x07 (el del boton)
L 0x4120 pide_sonido_08 pide el sonido 0x08
L 0x4125 pide_sonido_09 pide el sonido 0x09
L 0x412A pide_sonido_0A pide el sonido 0x0A
L 0x412F pide_musica_0B pide la musica 0x0B (la de la tecla F3)
L 0x4134 pide_musica_0C pide la musica 0x0C (la de la partida, tecla F2)
L 0x4139 pide_sonido_0D pide el sonido 0x0D
L 0x413E pide_sonido_0E pide el sonido 0x0E
L 0x4143 pide_sonido_0F pide el sonido 0x0F
L 0x4148 pide_sonido_10 pide el sonido 0x10
L 0x414D voz_pon dice PON: la voz 0x11 con el tono del personaje de 0xC20D
L 0x4158 voz_chi dice CHI: la voz 0x12 con el tono del personaje de 0xC20D
L 0x4163 voz_kan dice KAN: la voz 0x13 con el tono del personaje de 0xC20D
L 0x416E voz_ron dice RON: la voz 0x14 con el tono del personaje de 0xC20D
L 0x4179 voz_riichi dice RIICHI: la voz 0x15 con el tono del personaje de 0xC207
L 0x4184 voz_tsumo dice TSUMO: la voz 0x16 con el tono del personaje de 0xC207
L 0x418F voz_17 la voz 0x17 (con el tono 0x83)
L 0x4199 pide_sonido_18 pide la voz 0x18
L 0x419E pide_orden_80 pide la orden 0x80 del motor de sonido (parar)
L 0x41A3 pide_orden_81 pide la orden 0x81 del motor de sonido (ritmo)
L 0x41A8 pide_orden_84 pide la orden 0x84 del motor de sonido (fundido)
L 0x41AD tono_de_la_voz pone el tono de voz del personaje A (tabla 0xC030)
L 0x41D5 pide_sonido pide al motor de sonido (p12:6003) el sonido A; pone los bancos 12-13-14 y devuelve los de antes
L 0x4207 bancos_1_2_3 pone los bancos 1-2-3 (y sus copias en 0xF0F1-3)
L 0x4223 bancos_4 pone el 4 (y sus copias en 0xF0F1-3)
L 0x4228 bancos_5_6 pone los bancos 5-6 (y sus copias en 0xF0F1-3)
L 0x422D bancos_7_8_9 pone los bancos 7-8-9 (y sus copias en 0xF0F1-3)
L 0x4232 bancos_10_11 pone los bancos 10-11 (y sus copias en 0xF0F1-3)
