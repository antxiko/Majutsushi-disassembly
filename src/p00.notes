L 0x4258 bancos_11 pone el 11 (y sus copias en 0xF0F1-3)
L 0x425D cuadro_del_juego un cuadro de la maquina de estados del juego (0xC000, 0xC001)
L 0x4A17 suma_puntos_actual suma al marcador del jugador 0xC207 el importe C (signo) y DE (BCD)
L 0x4A1A suma_puntos suma al marcador del jugador A (3 bytes en 0xC0A0 + 3 x A) el importe C (signo) y DE (BCD)
L 0x4AF5 resta_uno_bcd_de DE = DE - 1 en BCD; Z si acaba en cero
L 0x4B46 dibuja_marcadores dibuja los cuatro paneles de puntos de los jugadores
L 0x4C54 numero_2_bytes escribe el numero BCD de 2 bytes de HL en DE
L 0x4C59 numero_con_signo escribe el numero BCD de HL en DE con '-' si es negativo
L 0x4CC9 numero_sin_ceros escribe B bytes BCD de HL en DE sin ceros por la izquierda
L 0x4D07 palabra_de_tabla HL = la palabra numero A de la tabla que apunta HL
L 0x4D12 lee_vram lee BC bytes de la VRAM (desde HL) a DE
L 0x4D2D copia_a_vram_hl copia BC bytes de HL a la VRAM en DE
L 0x4D40 copia_a_vram copia BC bytes de la RAM (DE) a la VRAM en HL
L 0x4D56 rellena_vram rellena BC bytes de la VRAM con A desde HL
L 0x4DAD direccion_lectura_vram_x2 direccion de lectura de la VRAM = HL x 2
L 0x4DE9 direccion_escritura_vram direccion de escritura de la VRAM = HL (el acarreo es el bit 16)
L 0x4E27 vuelca_lista_vram vuelca a la VRAM una lista de bloques (direccion, n, datos; 0 acaba)
L 0x4E50 limpia_pantalla apaga la pantalla, quita los sprites y borra la VRAM visible
L 0x4E69 pantalla_on enciende la pantalla
L 0x4E76 pantalla_off apaga la pantalla
L 0x4E83 quita_sprites pone todos los sprites fuera de pantalla
L 0x4EB2 pon_color escribe el color D,E en la paleta A
L 0x4EDC pon_colores aplica una lista de colores (A, D, E; 0xFF acaba)
L 0x4EEA espera_vdp espera a que el VDP acabe la orden en marcha
L 0x4F18 vdp_linea LINE: traza una linea (HL = origen, B = largo, C = grosor, A = color)
L 0x4FE5 vdp_hmmv_2 HMMV: rellena un rectangulo con el color A (origen HL, D = pagina, tamano BC)
L 0x5024 vdp_copia HMMM: copia un rectangulo de la VRAM (origen HL, destino DE, tamano BC, A = paginas)
L 0x5074 vdp_lmmc LMMC: manda al VDP un rectangulo con puntos de HL
L 0x50E1 vdp_lmcm LMCM: lee un rectangulo de la VRAM a DE
L 0x5151 vdp_lmmm LMMM: copia un rectangulo con operacion logica (A)
L 0x5363 dibuja_lista_tiles dibuja una lista de tiles de HL (x, y, tiles; 0xFF acaba)
L 0x5398 dibuja_tile dibuja el tile A de 8 x 8 en D,E
L 0x53AA dibuja_tile_pagina1 dibuja el tile A en D,E con la copia de la pagina 1
L 0x53DE origen_tile HL = el origen en la hoja de tiles del tile A
L 0x53EE avanza_tile D += 8 (y E += 8 si D da la vuelta)
L 0x558C arranca_pantalla arranca el sonido, pone SCREEN 7 y limpia la VRAM
L 0x55F0 lee_mandos lee los mandos y el teclado
L 0x568A carga_fondo_mesa carga el fondo de la mesa (bancos 7-9)
L 0x5911 carga_imagen carga y dibuja una imagen de tiles (HL = lista, DE = tabla de paletas)
L 0x59CD copia_sprites copia la tabla de colores de los sprites a la VRAM
L 0x5A22 dibuja_mesa carga las fichas y el tapete de los bancos 7-9
L 0x5ACD escribe_texto escribe un texto de letras de 16 puntos de alto en D,E
L 0x5B29 dibuja_letra dibuja la letra A de 16 x 16 con el color C
L 0x5DF5 prepara_partida prepara la pantalla de la partida
L 0x5E4D mano_del_actual HL = la mano del jugador 0xC207 y la guarda en 0xC0DE
L 0x5E54 mano_de_jugador HL = 0xD000 + 0x400 x 0xC207
L 0x5E5F sprites_fuera pone los 32 sprites fuera de pantalla
L 0x5E6D borra_manos borra 4 KB de 0xD000 (las manos)
L 0x5E7B turno_humano un paso de las respuestas del humano
