# Puntos de entrada del banco 2 (se ejecuta en 0x8000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador (cartucho.DESPACHADOR), que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x8001   # p01:7FFF sigue de largo (el codigo cruza la frontera de banco)
0x8039   # p01:728D call
0x8578   # p03:A0A8 call
0x85E0   # p03:A172 call
0x8680   # p01:7204 call
0x86A0   # p02:868D entrada 0 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x86A1   # p02:868D entrada 1 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x86AF   # p02:868D entrada 2 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x86BD   # p02:868D entrada 3 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x86CB   # p02:868D entrada 4 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x86D9   # p02:868D entrada 5 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x86E1   # p02:868D entrada 6 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x86E9   # p02:868D entrada 7 de la tabla de 0x8690 (call 0x4066 en 0x868D)
0x8711   # p01:71EB call
0x87E3   # p03:A114 call
