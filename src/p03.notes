L 0xA747 cuenta_atras_cuadro cuenta atras del cuadro de la voz
L 0xA74F borra_cuadro_voz borra el cuadro de la cara que habla
L 0xA791 suma_kan suma uno a los kan del jugador 0xC207
L 0xB59C paga_esperas paga las esperas de una ronda sin ganador
