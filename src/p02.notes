L 0x8039 prepara_descarte elige la ficha que va a tirar la maquina
L 0x8066 posicion_de_la_elegida busca en la mano la posicion de la ficha elegida (C) y la deja en 0xC20A
L 0x8189 fichas_de_grupos A = fichas de los grupos hechos (+0x0E, +0x140, +0x150, +0x160)
