L 0x85D8 mano_del_que_responde H += 4 x jugador de 0xC20D
L 0x85E0 prueba_mano_con_ficha prueba la mano del que responde con la ficha de 0xC209 o C
L 0x8601 alguien_espera_esa mira si la ficha tirada le sirve a alguien
L 0x8680 manera_de_jugar despacha por la manera de jugar de la maquina (+0x96)
L 0x8711 busca_ficha_util busca una ficha que le sirva entre las listas de los demas
L 0x886B piensa_si_sigue decide si vale la pena seguir con esa mano
